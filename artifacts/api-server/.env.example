# MongoDB connection string. Add the database name before '?': ...mongodb.net/<dbname>?...
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/fitsync

# Set a dedicated secret value
JWT_SECRET=

# Server port
PORT=8080

# Path to the built frontend (defaults to artifacts/fitsync/dist/public).
# Leave unset to serve the frontend from this server in single-domain deploys.
# STATIC_DIR=

# Comma-separated list of allowed origins when the frontend is hosted
# separately (e.g. CORS_ORIGIN=https://app.example.com,https://staging.example.com).
# Leave unset for single-domain deploys (same-origin needs no CORS).
# CORS_ORIGIN=

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=