# MongoDB connection string. Add the database name before '?': ...mongodb.net/<dbname>?...
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/fitsync

# Set a dedicated secret value
JWT_SECRET=

# Server port
PORT=8080

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=